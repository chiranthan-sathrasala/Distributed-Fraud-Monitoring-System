# Team addresses and shared settings.  Every script sources this file (via common/env.sh).
# Machine-specific overrides (e.g. a different jar path) go into config/cluster.local.env,
# which is NOT committed (see .gitignore note in README).

# ZeroTier network BigData2026_Team4
export VM1_IP=192.168.193.163      # Abdul  - Kafka broker + producer
export VM2_IP=192.168.193.39       # Anirudh - Spark master + driver
export VM3_IP=192.168.193.59       # Chiranthan - HDFS + Iceberg + worker + verifier
export VM4_IP=__FILL_VM4_IP__      # Prajwal - worker + dashboard   <-- fill in when known

export KAFKA_BOOTSTRAP="${VM1_IP}:9092"
export SPARK_MASTER_URL="spark://${VM2_IP}:7077"
export HDFS_URI="hdfs://${VM3_IP}:9000"

export ICEBERG_CATALOG=iceberg_catalog
export ICEBERG_DB=fraud
export ICEBERG_WAREHOUSE="${HDFS_URI}/warehouse"
export CHECKPOINT_BASE="${HDFS_URI}/checkpoints"

# Versions fixed by the course guides: Spark 3.3.4 / Scala 2.12 / Iceberg 1.8.1
export ICEBERG_JAR=/opt/iceberg/iceberg-spark-runtime-3.3_2.12-1.8.1.jar
export KAFKA_PACKAGE=org.apache.spark:spark-sql-kafka-0-10_2.12:3.3.4
